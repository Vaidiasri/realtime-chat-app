# docker-compose runs without this file (it has dev defaults inline).
# Copy to .env for `npm run dev` on the host, or to override compose defaults.
# Placeholder values only; use real random secrets for any deploy.

POSTGRES_USER=chat
POSTGRES_PASSWORD=chat
POSTGRES_DB=chat
DB_PORT=5432
APP_PORT=3000

# Host dev talks to the compose db on localhost; inside compose the app uses host "db".
DATABASE_URL=postgres://chat:chat@localhost:5432/chat
PORT=3000
NODE_ENV=development

# At least 32 characters each.
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-0123456789
